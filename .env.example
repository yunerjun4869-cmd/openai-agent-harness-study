# OpenAI API 密钥。真实运行前复制为 .env，不要提交 .env。
OPENAI_API_KEY=
# 可按账户可用模型修改；需要支持 Responses API 与 function calling。
OPENAI_MODEL=gpt-6-astra
# 默认使用官方端点；兼容网关需自己验证 Responses 与 reasoning 支持。
# OPENAI_BASE_URL=https://api.openai.com/v1
# s14 可选：OpenAI 服务能够访问的可信远程 MCP HTTPS 地址。
# MCP_SERVER_URL=https://your-mcp.example.com/mcp
